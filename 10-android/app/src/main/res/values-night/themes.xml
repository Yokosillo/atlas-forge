<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante oscura del tema base (ver la variante clara en values/themes.xml).
  Replica el esquema fallback oscuro de `ui/theme/Color.kt` para que, en
  modo oscuro del sistema, el splash antes de Compose sea coherente con el
  `darkColorScheme` del tema Compose.
-->
<resources>
    <style name="Theme.FactoryBrain" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fab_background</item>
        <item name="android:colorBackground">@color/fab_background</item>
        <item name="android:statusBarColor">@color/fab_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/fab_background</item>
        <item name="android:textColorPrimary">@color/fab_on_surface</item>
        <item name="android:textColorSecondary">@color/fab_on_surface_variant</item>
        <item name="android:colorPrimary">@color/fab_primary</item>
        <item name="android:colorPrimaryDark">@color/fab_primary</item>
        <item name="android:colorAccent">@color/fab_primary</item>
    </style>
</resources>